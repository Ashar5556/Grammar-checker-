{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "grammar-checker-smoky.vercel.app"
        }
      ],
      "destination": "https://grammarify.xyz/$1",
      "statusCode": 307
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.grammarify.xyz"
        }
      ],
      "destination": "https://grammarify.xyz/$1",
      "statusCode": 307
    }
  ]
}

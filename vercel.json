{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "grammar-checker-smoky.vercel.app"
        }
      ],
      "destination": "https://grammarify.xyz/$1",
      "statusCode": 307
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.grammarify.xyz"
        }
      ],
      "destination": "https://grammarify.xyz/$1",
      "statusCode": 307
    }
  ],
  "routes": [
    { "src": "/faqs", "dest": "/faqs.html" },
    { "src": "/privacy-policy", "dest": "/privacy-policy.html" },
    { "src": "/terms-of-use", "dest": "/terms-of-use.html" },
    { "src": "/about-us", "dest": "/about-us.html" },
    { "src": "/grammar-resources", "dest": "/blog/index.html" },
    { "src": "/blog", "dest": "/blog/index.html" }
  ]
}


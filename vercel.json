{
  "redirects": [
    {
      "source": "/grammar-resources",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "grammar-checker-smoky.vercel.app" }
      ],
      "destination": "https://grammarify.xyz/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.grammarify.xyz" }
      ],
      "destination": "https://grammarify.xyz/$1",
      "statusCode": 308
    }
  ],

  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog.html", "destination": "/blog/index.html" },

    { "source": "/faqs", "destination": "/faqs.html" },
    { "source": "/faqs.html", "destination": "/faqs.html" },

    { "source": "/privacy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy.html" },
    { "source": "/privacy(.*)", "destination": "/privacy-policy.html" },

    { "source": "/about", "destination": "/about-us.html" },
    { "source": "/about-us", "destination": "/about-us.html" },
    { "source": "/about-us.html", "destination": "/about-us.html" },
    { "source": "/about(.*)", "destination": "/about-us.html" },

    { "source": "/term", "destination": "/terms-of-use.html" },
    { "source": "/terms", "destination": "/terms-of-use.html" },
    { "source": "/terms-of", "destination": "/terms-of-use.html" },
    { "source": "/terms-of-use", "destination": "/terms-of-use.html" },
    { "source": "/terms-of-use.html", "destination": "/terms-of-use.html" },
    { "source": "/terms(.*)", "destination": "/terms-of-use.html" }
  ]
}

